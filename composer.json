{
  "name": "wexample/symfony-translations-ds",
  "version": "2.0.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTranslationsDs\\": "src/"
    }
  },
  "description": "The design system side of wexample/symfony-translations: the language switcher",
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=25.0.0",
    "wexample/symfony-helpers": ">=12.0.0",
    "wexample/symfony-loader": ">=16.0.0",
    "wexample/symfony-translations": ">=7.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}